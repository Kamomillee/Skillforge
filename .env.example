# Aucune variable n'est nécessaire : l'application fonctionne entièrement sans clé (tuteur local, progression
# dans le navigateur). Le serveur (pnpm serve) ajoute comptes, synchronisation, tuteur IA et administration.
#
# Tuteur IA (optionnel), lu UNIQUEMENT par le serveur (server/main.ts) — jamais dans le bundle navigateur.
# Ne commite jamais ce fichier une fois rempli (.env est ignoré par git).
# ANTHROPIC_API_KEY=
#
# Démo sans clé ni facturation : réponses simulées et déterministes (consommation estimée, signalée comme telle).
# SKILLFORGE_TUTEUR=simule
#
# Comptes : e-mails qui reçoivent le rôle administrateur à l'inscription (séparés par des virgules).
# SKILLFORGE_ADMINS=enseignant@example.ch
# Base SQLite du serveur (créée au premier lancement) :
# SKILLFORGE_DB=data/skillforge.db
# Cookie de session « Secure » (à activer derrière HTTPS) :
# SKILLFORGE_COOKIE_SECURE=1
#
# Budget IA par compte et par jour (plafond technique, aucune facturation) :
# AI_REQUESTS_PER_USER_PER_DAY=30
# AI_TOKENS_PER_USER_PER_DAY=60000
#
# Garde-fous globaux (valeurs par défaut) :
# AI_MAX_REQUESTS_PER_MINUTE=6
# AI_MAX_REQUESTS_PER_DAY=200
# PORT=8787
