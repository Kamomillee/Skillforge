# Aucune variable n'est nécessaire : l'application fonctionne entièrement sans clé (tuteur local).
#
# Tuteur IA (optionnel), lu UNIQUEMENT par le serveur (server/main.ts) — jamais dans le bundle navigateur.
# Ne commite jamais ce fichier une fois rempli (.env est ignoré par git).
# ANTHROPIC_API_KEY=
#
# Démo sans clé ni facturation : réponses simulées et déterministes.
# SKILLFORGE_TUTEUR=simule
#
# Garde-fous (valeurs par défaut) :
# AI_MAX_REQUESTS_PER_MINUTE=6
# AI_MAX_REQUESTS_PER_DAY=200
# PORT=8787
